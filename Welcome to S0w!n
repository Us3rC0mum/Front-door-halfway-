local fontArcade = Enum.Font.Arcade

local function LoadMainScript()
    task.spawn(function()
        local rawUrl = "https://raw.githubusercontent.com/Us3RSPWAN003/Just-a-weak-barrier/refs/heads/main/Barrier%20two%20Project%20%E2%80%A2P%23WN!"
        local success, scriptContent = pcall(function()
            return game:HttpGet(rawUrl)
        end)
        
        if success and scriptContent then
            local func, err = loadstring(scriptContent)
            if func then
                func()
            else
                warn("Erro ao compilar o script:", err)
            end
        end
    end)
end

