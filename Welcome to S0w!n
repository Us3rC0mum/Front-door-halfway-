    end)
end

local function Create(className, parent, properties, corner, stroke)
    local obj = Instance.new(className)
    for k, v in pairs(properties) do obj[k] = v end
    if corner then Instance.new("UICorner", obj).CornerRadius = UDim.new(0, corner) end
    if stroke then
        local str = Instance.new("UIStroke", obj)
        for k, v in pairs(stroke) do str[k] = v end
    end
    if parent then obj.Parent = parent end return obj
end

local function MakeDraggable(frame)
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            PlayClickSound()
        end
    end)
end

local function AddClickEffect(frame)
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local mousePos = input.Position
            local framePos = frame.AbsolutePosition
            local relativeX = mousePos.X - framePos.X
            local relativeY = mousePos.Y - framePos.Y

            local cursorEffect = Create("ImageLabel", frame, {
                Name = "ClickCursor",
                Size = UDim2.new(0, 32, 0, 32),
                Position = UDim2.new(0, relativeX - 16, 0, relativeY - 16),
                Image = "rbxassetid://82418202057512",
                BackgroundTransparency = 1,
                ImageTransparency = 0,
                ZIndex = 20
            })

            task.delay(0.35, function()
                if cursorEffect and cursorEffect.Parent then
                    TweenService:Create(cursorEffect, TweenInfo.new(0.4), { ImageTransparency = 1 }):Play()
                end
            end)

            Debris:AddItem(cursorEffect, 0.75)
        end
    end)
end

