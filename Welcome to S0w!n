local FOLDER_NAME = "ProjectSpawnismo"
local FILE_NAME = FOLDER_NAME .. "/KeyAuth.json"

local function SaveKeySession()
    if writefile and isfolder and makefolder then
        if not isfolder(FOLDER_NAME) then
            pcall(makefolder, FOLDER_NAME)
        end
        local data = HttpService:JSONEncode({ timestamp = os.time() })
        pcall(writefile, FILE_NAME, data)
    end
end

